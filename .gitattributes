# 统一换行符：仓库内始终 LF，检出时按平台给该给的回车
* text=auto

# Linux/macOS 上执行的脚本必须是 LF，否则 bash 会报 bad interpreter
*.sh    text eol=lf
*.py    text eol=lf

# Windows 批处理保持 CRLF（cmd 对纯 LF 的批处理有兼容问题）
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制，避免 diff 噪音与换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.docx binary
*.xlsx binary
*.pdf binary
